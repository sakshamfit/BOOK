# Dependencies
/node_modules/
/.pnp
.pnp.*
# Keep authored Yarn tooling if the project adopts Yarn.
/.yarn/*
!/.yarn/patches/
!/.yarn/plugins/
!/.yarn/releases/
!/.yarn/versions/

# Generated builds and framework state
/dist/
/.next/
/.vinext/
/out/
next-env.d.ts
*.tsbuildinfo

# Test output
/coverage/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment and keys
.env*
.dev.vars*
*.pem

# Checkout-local tool state
/.wrangler/
/.sites-runtime/

# Workspace scaffolding and publication archives
/.agents/
/.codex/
/outputs/
/work/

# OS metadata
.DS_Store

# Code-only repository: videos, images, fonts and 3D asset files stay local
/showcase/
*.mp4
*.webm
*.mov
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.avif
/public/*.svg
/public/covers/
/public/fonts/
*.otf
*.ttf
*.woff
*.woff2
*.glb
*.gltf
*.fbx
*.obj
*.hdr

# Local editor and assistant settings
/.claude/
